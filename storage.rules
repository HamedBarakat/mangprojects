rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // ── Chat file uploads ──────────────────────────────────────────────────────
    // Any authenticated user can read/write under chats/.
    // Writes are capped at 20 MB per file.
    match /chats/{allPaths=**} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 20 * 1024 * 1024;
    }

    // ── All other paths — keep existing behaviour (deny by default) ───────────
  }
}
