rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function currentUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn() && (currentUser().adminFlag == true || currentUser().role == 'admin');
    }

    function isReviewer() {
      return isSignedIn() && currentUser().role == 'reviewer';
    }

    function isTeamLeader() {
      return isSignedIn() && currentUser().role == 'team_leader';
    }

    function isEngineer() {
      return isSignedIn() && currentUser().role == 'engineer';
    }

    function isDC() {
      return isSignedIn() && currentUser().role == 'dc';
    }

    function isManagement() {
      return isSignedIn() && currentUser().role == 'management';
    }

    function isSectionHeadOrAbove() {
      return isSignedIn() && (
        currentUser().jobTitle == 'head_of_department' ||
        currentUser().jobTitle == 'coo' ||
        currentUser().jobTitle == 'principal_managing_partner' ||
        currentUser().jobTitle == 'technical_office_manager'
      );
    }

    function canSeeAll() {
      return isAdmin() || isReviewer() || isDC() || isManagement() || isSectionHeadOrAbove();
    }

    function isAdminOrReviewer() {
      return isAdmin() || isReviewer();
    }

    function isTeamLeaderOrAbove() {
      return isAdmin() || isReviewer() || isTeamLeader() || isManagement();
    }

    function belongsToOffice(officeId) {
      return isSignedIn() && currentUser().officeId == officeId;
    }

    function isClientRole() {
      return isSignedIn() && currentUser().role == 'client';
    }

    // ── Offices ─────────────────────────────────────────────────────────────
    // The root office document holds only public fields (code, name, isActive,
    // logo) and is readable without authentication so the office-code entry
    // screen can validate a code before the user signs in.
    // Sensitive configuration lives exclusively in the settings subcollection,
    // which remains restricted to signed-in users.
    match /offices/{officeId} {
      allow read: if true;
      allow write: if isAdmin();

      match /settings/{doc} {
        allow read: if isSignedIn();
        allow write: if isAdmin();
      }
    }

    // ── Users ────────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isSignedIn() && (
        request.auth.uid == userId ||
        currentUser().officeId == resource.data.officeId
      );
      allow create: if isSignedIn();
      allow update: if isAdmin() || request.auth.uid == userId;
      allow delete: if isAdmin();
    }

    // ── Clients ──────────────────────────────────────────────────────────────
    match /clients/{clientId} {
      allow read: if isSignedIn();
      allow write: if isAdminOrReviewer();
    }

    // ── Projects ─────────────────────────────────────────────────────────────
    match /projects/{projectId} {
      allow read: if isSignedIn() && (
        belongsToOffice(resource.data.officeId) ||
        isClientRole()
      );
      allow create: if isAdminOrReviewer();

      // Admin/Reviewer/TL/DC can update freely within their office.
      // Engineers are restricted to only updating the completionPercentage field
      // (the only field _recalculateProjectCompletion writes), preventing them
      // from modifying project metadata.
      allow update: if isAdminOrReviewer()
        || (isDC() && belongsToOffice(resource.data.officeId))
        || (isTeamLeader() && belongsToOffice(resource.data.officeId))
        || (isEngineer() && belongsToOffice(resource.data.officeId)
            && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['completionPercentage', 'updatedAt']));

      allow delete: if isAdmin();

      match /tasks/{taskId} {
        allow read: if isSignedIn();
        allow write: if isSignedIn() && isTeamLeaderOrAbove();
      }
    }

    // ── Tasks (root collection) ───────────────────────────────────────────────
    match /tasks/{taskId} {
      // FIX: scope reads to the user's own office — prevents cross-office data leaks.
      // Client role checks their linkedClientId in code; Firestore allows the read
      // because clientRole users still belong to the same office via officeId.
      allow read: if isSignedIn() && (
        belongsToOffice(resource.data.officeId) ||
        isClientRole()
      );

      allow create: if isSignedIn() && isTeamLeaderOrAbove();

      allow update: if isSignedIn() && (
        belongsToOffice(resource.data.officeId) ||
        isDC() ||
        isClientRole()
      );

      allow delete: if isAdminOrReviewer();

      match /comments/{commentId} {
        allow read, write: if isSignedIn();
      }
      match /attachments/{attachmentId} {
        allow read: if isSignedIn();
        allow write: if isSignedIn();
      }
    }

    // ── Task Activities ───────────────────────────────────────────────────────
    match /task_activities/{activityId} {
      // FIX: scope reads to the user's own office — prevents cross-office audit log leaks.
      allow read: if isSignedIn() && belongsToOffice(resource.data.officeId);
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // ── Notifications ────────────────────────────────────────────────────────
    match /notifications/{notifId} {
      allow read: if isSignedIn() && (
        resource.data.recipientId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        resource.data.recipientId == request.auth.uid ||
        isAdmin()
      );
      allow delete: if isSignedIn() && (
        resource.data.recipientId == request.auth.uid ||
        isAdmin()
      );
    }

    // ── Attendance ───────────────────────────────────────────────────────────
    match /attendance/{docId} {
      allow read: if isSignedIn() && (
        resource.data.employeeId == request.auth.uid ||
        belongsToOffice(resource.data.officeId) ||
        canSeeAll()
      );
      allow write: if isSignedIn() && (
        request.resource.data.employeeId == request.auth.uid ||
        belongsToOffice(request.resource.data.officeId)
      );
    }

    // ── Daily Logs ───────────────────────────────────────────────────────────
    match /daily_logs/{docId} {
      allow read: if isSignedIn() && belongsToOffice(resource.data.officeId);
      allow write: if isSignedIn() && belongsToOffice(request.resource.data.officeId);
    }

    // ── Overtime Requests ────────────────────────────────────────────────────
    match /overtime_requests/{docId} {
      allow read: if isSignedIn() && belongsToOffice(resource.data.officeId);
      allow write: if isSignedIn() && belongsToOffice(request.resource.data.officeId);
    }

    // ── Leave Requests ───────────────────────────────────────────────────────
    match /leave_requests/{docId} {
      allow read: if isSignedIn() && (
        resource.data.employeeId == request.auth.uid ||
        (isAdmin() && belongsToOffice(resource.data.officeId)) ||
        (isManagement() && belongsToOffice(resource.data.officeId)) ||
        isSectionHeadOrAbove()
      );
      allow create: if isSignedIn() &&
        request.resource.data.employeeId == request.auth.uid;
      allow update: if isSignedIn() && (
        isAdmin() ||
        isManagement() ||
        isSectionHeadOrAbove() ||
        (resource.data.employeeId == request.auth.uid &&
          request.resource.data.status == 'cancelled')
      );
      allow delete: if isAdmin();
    }

    // ── Developers ───────────────────────────────────────────────────────────
    // FIX: restrict to admin only — developer panel data must not be accessible
    // by regular employees.
    match /developers/{devId} {
      allow read, write: if isAdmin();
    }
  }
}
